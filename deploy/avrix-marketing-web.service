[Unit]
Description=Avrix marketing website
After=network.target postgresql@16-main.service

[Service]
User=avrixmarketing
Group=avrixmarketing
Slice=avrix-marketing.slice
WorkingDirectory=/opt/avrix-marketing/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=320
Environment=PATH=/opt/avrix-marketing/node/bin:/usr/bin:/bin
ExecStart=/opt/avrix-marketing/node/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3010
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/avrix-marketing
UMask=0027

[Install]
WantedBy=multi-user.target
