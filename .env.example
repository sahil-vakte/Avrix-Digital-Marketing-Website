# ─────────────── App ───────────────
APP_URL=https://avrix-europe.com            # public URL, used in tracking + unsubscribe links
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://avrix:CHANGE_ME@localhost:5432/avrix
AUTH_SECRET=CHANGE_ME_64_RANDOM_CHARS       # openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS       # openssl rand -hex 32 (encrypts 2FA secrets + OAuth key at rest)
IP_HASH_SALT=CHANGE_ME                      # any random string; tracking IPs are stored hashed

# First admin (created by `npm run db:seed`; change the password after first login)
ADMIN_EMAIL=ab@example.com
ADMIN_PASSWORD=ChangeMe-OnFirstLogin-2026!
ADMIN_NAME=AB
ADMIN_ALERT_EMAIL=ab@example.com            # receives new-lead + campaign auto-pause alerts

# ─────────────── SMTP (Google Workspace) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                               # 465 = SSL, or 587 with SMTP_SECURE=false (STARTTLS)
SMTP_SECURE=true
SMTP_USER=outreach@avrix-europe.com
MAIL_FROM_NAME="Avrix UK & Europe"
MAIL_FROM_ADDRESS=outreach@avrix-europe.com
MAIL_REPLY_TO=outreach@avrix-europe.com

# Google auth — choose one
GOOGLE_AUTH_MODE=app_password               # app_password | oauth2
SMTP_PASS=                                  # 16-char Google app password (needs 2-Step Verification)
# OAuth 2.0 via service account + domain-wide delegation (scope: https://mail.google.com/)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=                 # PEM private key, \n-escaped on one line

# ─────────────── IMAP (same mailbox: bounces + replies) ───────────────
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=outreach@avrix-europe.com
IMAP_PASS=                                  # usually the same app password as SMTP_PASS
IMAP_POLL_MINUTES=5

# ─────────────── Sending limits (Google: 2,000/day paid, 500/day trial) ───────────────
SEND_DAILY_CAP=1000
SEND_HOURLY_CAP=150
SEND_MIN_GAP_SECONDS=30
SEND_MAX_GAP_SECONDS=120
WARMUP_ENABLED=true
WARMUP_SCHEDULE=20,40,80,150,300,500,800    # daily cap for day 1, 2, 3… after first send; then SEND_DAILY_CAP
BOUNCE_PAUSE_THRESHOLD=0.03                 # auto-pause a campaign above this bounce rate
BOUNCE_PAUSE_MIN_SENT=50                    # …once at least this many have been sent

# ─────────────── Company footer (required in every email) ───────────────
COMPANY_LEGAL_NAME="Avrix UK & Europe Business Marketing"
COMPANY_POSTAL_ADDRESS="Address line 1, Leicester, LE1 0AA, United Kingdom"
COMPANY_PHONE="+44 0000 000000"
COMPANY_WHATSAPP=440000000000               # digits only, for wa.me links

# ─────────────── Website analytics (loaded only after cookie consent) ───────────────
NEXT_PUBLIC_SITE_NAME="Avrix UK & Europe"
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Set true only while the background worker is intentionally stopped.
CRM_WORKER_PAUSED=false
